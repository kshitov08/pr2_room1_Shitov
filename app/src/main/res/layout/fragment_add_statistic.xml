<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A2E"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добавить статистику"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Результат: "
        android:layout_marginStart="-55dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"/>

    <Spinner
        android:id="@+id/spinnerResult"
        android:layout_width="90dp"
        android:layout_height="30dp"
        android:layout_marginTop="-35dp"
        android:layout_marginStart="33dp"
        android:layout_marginBottom="30dp"
        android:background="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сложность: "
        android:layout_marginStart="-55dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"/>

    <Spinner
        android:id="@+id/spinnerDifficult"
        android:layout_width="90dp"
        android:layout_height="30dp"
        android:layout_marginTop="-35dp"
        android:layout_marginStart="38dp"
        android:layout_marginBottom="30dp"
        android:background="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Уровень: "
        android:layout_marginStart="-55dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"/>

    <Spinner
        android:id="@+id/spinnerLevel"
        android:layout_width="90dp"
        android:layout_height="30dp"
        android:layout_marginTop="-35dp"
        android:layout_marginStart="27dp"
        android:layout_marginBottom="30dp"
        android:background="#FFFFFF" />
    <EditText
        android:id="@+id/editError"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/editbox"
        android:hint="Количество ошибок"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editPoints"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:hint="Количество очков"
        android:background="@drawable/editbox"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textSize="16sp"
        android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="Добавить"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#4CAF50"
            android:textSize="16sp"/>


</LinearLayout>